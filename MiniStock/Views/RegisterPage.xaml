<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniStock.ViewModels"
             x:Class="MiniStock.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Inscription"
             BackgroundColor="{StaticResource StockBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,22" Spacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,8">
                <Label Text="←"
                       FontSize="27"
                       TextColor="{StaticResource StockNavy}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1"
                       Text="Mini Suivi de Stock"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource StockNavy}"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="5">
                <Label Text="Créer un compte"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="{StaticResource StockNavy}" />
                <Label Text="Rejoignez-nous pour mieux gérer votre stock et éviter les ruptures."
                       FontSize="14"
                       TextColor="{StaticResource StockMuted}" />
            </VerticalStackLayout>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Label Text="♙" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Nom}" Placeholder="Nom complet *" ReturnType="Next" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Label Text="⌂" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding NomBoutique}" Placeholder="Nom de la boutique *" ReturnType="Next" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Label Text="✉" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="Email *" Keyboard="Email" ReturnType="Next" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                    <Label Text="☎" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Telephone}" Placeholder="Téléphone *" Keyboard="Telephone" ReturnType="Next" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                    <Label Text="♙" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding MotDePasse}" Placeholder="Mot de passe *" IsPassword="{Binding IsPasswordHidden}" ReturnType="Next" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="◉" FontSize="19" TextColor="{StaticResource StockMuted}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="62" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                    <Label Text="♙" FontSize="22" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding ConfirmationMotDePasse}" Placeholder="Confirmer le mot de passe *" IsPassword="{Binding IsConfirmationHidden}" ReturnType="Done" TextColor="#273F50" PlaceholderColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="◉" FontSize="19" TextColor="{StaticResource StockMuted}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleConfirmationCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Label Text="{Binding Message}"
                   IsVisible="{Binding AfficherMessage}"
                   TextColor="{Binding MessageColor}"
                   FontSize="13" />

            <Button Text="{Binding TexteBouton}"
                    Command="{Binding SubmitCommand}"
                    BackgroundColor="{StaticResource StockOrange}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="58" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,6,0,0">
                <Label Text="Déjà un compte ?"
                       FontSize="14"
                       TextColor="{StaticResource StockMuted}"
                       VerticalOptions="Center" />
                <Label Text="Se connecter"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource StockNavy}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
