<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniStock.ViewModels"
             xmlns:views="clr-namespace:MiniStock.Views"
             x:Class="MiniStock.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Réglages"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource StockBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,12,18,16" Spacing="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Paramètres" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" VerticalOptions="Center" />
                    <Image Grid.Column="1" Source="lucide_settings.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                </Grid>

                <Border Stroke="#F0E2D8" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="14" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="62,*" ColumnSpacing="12">
                        <Border WidthRequest="54" HeightRequest="54" StrokeThickness="0" StrokeShape="RoundRectangle 27" BackgroundColor="#E7F3FB" VerticalOptions="Center">
                            <Image Source="lucide_user.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#263F50" />
                            <Label Text="{Binding Email}" FontSize="12" TextColor="{StaticResource StockMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Ma boutique" FontSize="17" FontAttributes="Bold" TextColor="#263F50" Margin="0,1,0,-5" />
                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12,5">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10" Padding="2,10">
                            <Image Source="lucide_store.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Nom de la boutique" FontSize="12" TextColor="{StaticResource StockMuted}" />
                                <Label Text="{Binding StoreName}" FontSize="14" FontAttributes="Bold" TextColor="#263F50" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource StockBorder}" />
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10" Padding="2,10">
                            <Image Source="lucide_phone.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Téléphone" FontSize="12" TextColor="{StaticResource StockMuted}" />
                                <Label Text="{Binding Phone}" FontSize="14" FontAttributes="Bold" TextColor="#263F50" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource StockBorder}" />
                        <Grid ColumnDefinitions="30,*" ColumnSpacing="10" Padding="2,10">
                            <Image Source="lucide_mail.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Adresse e-mail du compte" FontSize="12" TextColor="{StaticResource StockMuted}" />
                                <Label Text="{Binding Email}" FontSize="14" FontAttributes="Bold" TextColor="#263F50" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding Message}" FontSize="13" TextColor="{StaticResource StockRed}" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
            <Button Grid.Row="0" Text="Se déconnecter" Command="{Binding LogoutCommand}"

                    BackgroundColor="White" TextColor="{StaticResource StockNavy}" BorderColor="{StaticResource StockBorder}"
                    BorderWidth="1" FontAttributes="Bold" CornerRadius="11" HeightRequest="50" Margin="18,8,18,12" />
            <views:StockTabBar Grid.Row="1" SelectedTab="Réglages" NavigateCommand="{Binding NavigateTabCommand}" />
        </Grid>
    </Grid>
</ContentPage>
