<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniStock.ViewModels"
             xmlns:data="clr-namespace:MiniStock.Services"
             xmlns:views="clr-namespace:MiniStock.Views"
             x:Class="MiniStock.Views.MovementsPage"
             x:DataType="vm:MovementsViewModel"
             Title="Mouvements"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource StockBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,12,18,14" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Mouvements de stock" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" />
                        <Label Text="Enregistrez chaque mouvement de stock" FontSize="12" TextColor="{StaticResource StockMuted}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="lucide_history.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,5,0,0">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,9" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectMovementTypeCommand}" CommandParameter="Entrée" /></Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Image Source="lucide_arrow_down_left.png" WidthRequest="20" HeightRequest="20" Opacity="0.55">
                                <Image.Triggers><DataTrigger TargetType="Image" Binding="{Binding SelectedType}" Value="Entrée"><Setter Property="Opacity" Value="1" /></DataTrigger></Image.Triggers>
                            </Image>
                            <Label Text="Entrée" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource StockMuted}">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding SelectedType}" Value="Entrée"><Setter Property="TextColor" Value="{StaticResource StockNavy}" /></DataTrigger></Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedType}" Value="Entrée"><Setter Property="BackgroundColor" Value="#E7F3FB" /></DataTrigger></Border.Triggers>
                    </Border>
                    <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,9" BackgroundColor="White">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectMovementTypeCommand}" CommandParameter="Sortie" /></Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Image Source="lucide_arrow_up_right.png" WidthRequest="20" HeightRequest="20" Opacity="0.55">
                                <Image.Triggers><DataTrigger TargetType="Image" Binding="{Binding SelectedType}" Value="Sortie"><Setter Property="Opacity" Value="1" /></DataTrigger></Image.Triggers>
                            </Image>
                            <Label Text="Sortie" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource StockMuted}">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding SelectedType}" Value="Sortie"><Setter Property="TextColor" Value="{StaticResource StockNavy}" /></DataTrigger></Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding SelectedType}" Value="Sortie"><Setter Property="BackgroundColor" Value="#E7F3FB" /></DataTrigger></Border.Triggers>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="0,-7,0,2">
                    <BoxView Grid.ColumnSpan="2" HeightRequest="2" Color="{StaticResource StockBorder}" />
                    <BoxView Grid.Column="0" HeightRequest="2" Color="{StaticResource StockNavy}" />
                </Grid>

                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,3">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="lucide_package.png" WidthRequest="21" HeightRequest="21" VerticalOptions="Center" />
                        <Picker Grid.Column="1" Title="Choisir un article" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" FontSize="14">
                            <Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="data:StockProduct" /></Picker.ItemDisplayBinding>
                        </Picker>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Stock actuel" FontSize="12" TextColor="{StaticResource StockMuted}" />
                    <Label Grid.Column="1" Text="{Binding CurrentStock, StringFormat='{0} unités'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" />
                </Grid>

                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,3">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="lucide_plus.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding SelectedType, StringFormat='Quantité à {0} *'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" />
                            <Entry Text="{Binding Quantity}" Placeholder="Quantité" Keyboard="Numeric" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,3">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="lucide_history.png" WidthRequest="21" HeightRequest="21" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Reason}" Placeholder="Motif (ex. Réapprovisionnement)" FontSize="14" />
                    </Grid>
                </Border>

                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="lucide_calendar.png" WidthRequest="21" HeightRequest="21" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Date du mouvement" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" />
                            <Label Text="{Binding MovementDate}" FontSize="13" TextColor="{StaticResource StockMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="{StaticResource StockBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Stock après le mouvement" FontSize="12" TextColor="#263F50" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding StockAfter}" FontSize="17" FontAttributes="Bold" TextColor="#263F50" />
                    </Grid>
                </Border>

                <Label Text="{Binding Message}" FontSize="13" TextColor="{StaticResource StockRed}" />
                <Button Text="{Binding SubmitButtonText}" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource StockOrange}"
                        TextColor="White" FontAttributes="Bold" CornerRadius="11" HeightRequest="52" />

                <Label Text="Dernier mouvement" FontSize="18" FontAttributes="Bold" TextColor="#263F50" Margin="0,1,0,0" />
                <Border IsVisible="{Binding HasMovements}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,10" BackgroundColor="White">
                    <Grid BindingContext="{Binding LatestMovement}" x:DataType="data:StockMovement" ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                        <Image Source="lucide_arrow_up_right.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ProductName}" FontSize="13" FontAttributes="Bold" TextColor="#263F50" />
                            <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}" FontSize="11" TextColor="{StaticResource StockMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Variation, StringFormat='{0:+#;-#;0}'}" FontSize="15" TextColor="{StaticResource StockMuted}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label Text="Aucun mouvement enregistré." IsVisible="{Binding HasNoMovements}" FontSize="13"
                       TextColor="{StaticResource StockMuted}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
        <views:StockTabBar Grid.Row="1" SelectedTab="Mouvements" NavigateCommand="{Binding NavigateTabCommand}" />
    </Grid>
</ContentPage>
