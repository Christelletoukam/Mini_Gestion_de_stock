<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniStock.ViewModels"
             x:Class="MiniStock.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Tableau de bord"
             BackgroundColor="{StaticResource StockBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,18,22,24" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tableau de bord"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                        <Label Text="{Binding Boutique}"
                               FontSize="13"
                               TextColor="{StaticResource StockMuted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="♧"
                           FontSize="27"
                           TextColor="{StaticResource StockNavy}"
                           VerticalOptions="Start"
                           Margin="0,2,3,0" />
                </Grid>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Bonjour, Gérant !"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#263F50" />
                    <Label Text="Voici un aperçu de votre stock aujourd’hui"
                           FontSize="13"
                           TextColor="{StaticResource StockMuted}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="7">
                    <Border Grid.Column="0" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="▣" FontSize="19" TextColor="{StaticResource StockNavy}" />
                            <Label Text="{Binding TotalArticles}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Articles" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="↙" FontSize="21" TextColor="{StaticResource StockGreen}" />
                            <Label Text="{Binding TotalEntrees}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Entrées" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="↗" FontSize="21" TextColor="{StaticResource StockRed}" />
                            <Label Text="{Binding TotalSorties}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Sorties" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="⚠" FontSize="20" TextColor="{StaticResource StockYellow}" />
                            <Label Text="{Binding NombreAlertes}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Alertes" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Stroke="{StaticResource StockBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16,13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Valeur du stock au prix de vente"
                                   FontSize="12"
                                   TextColor="{StaticResource StockMuted}" />
                            <Label Text="{Binding ValeurStock}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StockNavy}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="▱"
                               FontSize="30"
                               TextColor="{StaticResource StockNavy}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="À réapprovisionner"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#263F50" />
                    <Label Grid.Column="1"
                           Text="Voir les alertes"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource StockNavy}"
                           VerticalOptions="Center" />
                </Grid>

                <Border Stroke="{StaticResource StockBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,5">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ArticlesAlerte}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StockAlerteViewModel">
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="0,8"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Nom}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#263F50" />
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Quantite}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource StockMuted}" />
                                            <Label Text="·"
                                                   FontSize="12"
                                                   TextColor="{StaticResource StockMuted}" />
                                            <Label Text="{Binding Etat}"
                                                   FontSize="12"
                                                   TextColor="{Binding Couleur}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="25"
                                           TextColor="{StaticResource StockNavy}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Actions rapides"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#263F50" />

                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="↔" FontSize="27" TextColor="{StaticResource StockNavy}" HorizontalTextAlignment="Center" />
                        <Label Text="Entrée / Sortie"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                        <Label Text="▣" FontSize="25" TextColor="{StaticResource StockNavy}" HorizontalTextAlignment="Center" />
                        <Label Text="Faire l’inventaire"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="#FFF8DF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⛨"
                               FontSize="18"
                               TextColor="#987112"
                               VerticalOptions="Center" />
                        <Label Text="2 articles demandent votre attention. Réapprovisionnez-les pour éviter les ruptures."
                               FontSize="12"
                               TextColor="#987112"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*"
              HeightRequest="72"
              Padding="7,7,7,4"
              BackgroundColor="White">
            <BoxView HeightRequest="1"
                     Color="{StaticResource StockBorder}"
                     VerticalOptions="Start"
                     HorizontalOptions="Fill"
                     Grid.ColumnSpan="5" />
            <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="⌂" FontSize="23" TextColor="{StaticResource StockNavy}" HorizontalTextAlignment="Center" />
                <Label Text="Accueil" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource StockNavy}" />
                <BoxView HeightRequest="3" WidthRequest="18" Color="{StaticResource StockOrange}" HorizontalOptions="Center" Margin="0,2,0,0" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="▣" FontSize="21" TextColor="{StaticResource StockMuted}" HorizontalTextAlignment="Center" />
                <Label Text="Articles" FontSize="10" TextColor="{StaticResource StockMuted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="↔" FontSize="23" TextColor="{StaticResource StockMuted}" HorizontalTextAlignment="Center" />
                <Label Text="Mouvements" FontSize="10" TextColor="{StaticResource StockMuted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="☑" FontSize="21" TextColor="{StaticResource StockMuted}" HorizontalTextAlignment="Center" />
                <Label Text="Inventaire" FontSize="10" TextColor="{StaticResource StockMuted}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="4" Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="⚙" FontSize="21" TextColor="{StaticResource StockMuted}" HorizontalTextAlignment="Center" />
                <Label Text="Réglages" FontSize="10" TextColor="{StaticResource StockMuted}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
    <ContentPage.Resources>
        <Style x:Key="DashboardMetricCard" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource StockBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 17" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HeightRequest" Value="112" />
        </Style>
        <Style x:Key="DashboardMetricValue" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource StockNavy}" />
        </Style>
        <Style x:Key="DashboardMetricCaption" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{StaticResource StockMuted}" />
        </Style>
    </ContentPage.Resources>
</ContentPage>
