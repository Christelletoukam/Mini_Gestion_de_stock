<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiniStock.ViewModels"
             xmlns:views="clr-namespace:MiniStock.Views"
             x:Class="MiniStock.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Tableau de bord"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource StockBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,12,18,16" Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tableau de bord"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                        <Label Text="{Binding Boutique}"
                               FontSize="13"
                               TextColor="{StaticResource StockMuted}" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="lucide_bell.png"
                                 Command="{Binding AlertsCommand}" WidthRequest="44" HeightRequest="44"
                                 Padding="10" BackgroundColor="Transparent" VerticalOptions="Center"
                                 SemanticProperties.Description="Voir les alertes" />
                </Grid>

                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding NomUtilisateur, StringFormat='Bonjour, {0} !'}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#263F50" />
                    <Label Text="Voici un aperçu de votre stock aujourd’hui"
                           FontSize="13"
                           TextColor="{StaticResource StockMuted}" />
                </VerticalStackLayout>

                <Label Text="{Binding Message}"
                       IsVisible="{Binding AfficherMessage}"
                       FontSize="13"
                       TextColor="{StaticResource StockRed}" />

                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="7">
                    <Border Grid.Column="0" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Image Source="lucide_package.png" WidthRequest="21" HeightRequest="21" />
                            <Label Text="{Binding TotalArticles}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Articles" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Image Source="lucide_arrow_down_left.png" WidthRequest="21" HeightRequest="21" />
                            <Label Text="{Binding TotalEntrees}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Entrées" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Image Source="lucide_arrow_up_right.png" WidthRequest="21" HeightRequest="21" />
                            <Label Text="{Binding TotalSorties}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Sorties" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource DashboardMetricCard}">
                        <VerticalStackLayout Spacing="2">
                            <Image Source="lucide_triangle_alert.png" WidthRequest="21" HeightRequest="21" />
                            <Label Text="{Binding NombreAlertes}" Style="{StaticResource DashboardMetricValue}" />
                            <Label Text="Alertes" Style="{StaticResource DashboardMetricCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Stroke="{StaticResource StockBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16,13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Valeur du stock au prix de vente"
                                   FontSize="12"
                                   TextColor="{StaticResource StockMuted}" />
                            <Label Text="{Binding ValeurStock}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StockNavy}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="lucide_wallet.png"
                               WidthRequest="28" HeightRequest="28" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="À réapprovisionner"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#263F50" />
                    <Label Grid.Column="1"
                           Text="Voir les alertes"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource StockNavy}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AlertsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border Stroke="{StaticResource StockBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14,5">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ArticlesAlerte}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StockAlerteViewModel">
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="0,8"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Nom}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#263F50" />
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Quantite}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource StockMuted}" />
                                            <Label Text="·"
                                                   FontSize="12"
                                                   TextColor="{StaticResource StockMuted}" />
                                            <Label Text="{Binding Etat}"
                                                   FontSize="12"
                                                   TextColor="{Binding Couleur}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Image Grid.Column="1" Source="lucide_chevron_right.png"
                                           WidthRequest="21" HeightRequest="21" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Actions rapides"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#263F50" />

                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MovementsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image Source="lucide_arrow_left_right.png" WidthRequest="27" HeightRequest="27" HorizontalOptions="Center" />
                        <Label Text="Entrée / Sortie"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding InventoryCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Image Source="lucide_clipboard_check.png" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" />
                        <Label Text="Faire l’inventaire"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StockNavy}" />
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="#FFF8DF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="lucide_shield_alert.png"
                               WidthRequest="21" HeightRequest="21" VerticalOptions="Center" />
                        <Label Text="{Binding NombreAlertes, StringFormat='{0} article(s) demandent votre attention. Réapprovisionnez-les pour éviter les ruptures.'}"
                               FontSize="12"
                               TextColor="#987112"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <views:StockTabBar Grid.Row="1" SelectedTab="Home" NavigateCommand="{Binding NavigateTabCommand}" />
    </Grid>
    <ContentPage.Resources>
        <Style x:Key="DashboardMetricCard" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource StockBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 17" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HeightRequest" Value="102" />
        </Style>
        <Style x:Key="DashboardMetricValue" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource StockNavy}" />
        </Style>
        <Style x:Key="DashboardMetricCaption" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{StaticResource StockMuted}" />
        </Style>
    </ContentPage.Resources>
</ContentPage>
